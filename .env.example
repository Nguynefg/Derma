# Copy to .env and enter secrets locally. Never commit .env.
# Optional: DATABASE_URL overrides backend/database.local.json.
DATABASE_URL=
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Optional online image analysis and grounded answers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_IMAGE_MODEL=
GEMINI_CHAT_MODEL=

# Leave empty to use backend/models/active/model-card.json.
DERMA_IMAGE_MODEL_CARD=
